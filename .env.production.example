# 머슬매니아 운영 설정 (서버의 pt-app 폴더에 .env.production 으로 복사해 값을 채움)
# 이 파일의 실제 값은 절대 커밋하지 않습니다.

# ── 주소 ─────────────────────────────────────────
# 앱 주소 (카톡 링크·알림 클릭·초대 링크에 쓰임)
DOMAIN=pt.rest-wifi.co.kr
APP_BASE_URL=https://pt.rest-wifi.co.kr
# 서버에 nginx 등 웹 서버가 없으면 https 로 두어 Caddy가 HTTPS를 자동 발급 / 있으면 비움
COMPOSE_PROFILES=
# nginx가 넘겨받을 앱 포트 (서버 안에서만 열림)
APP_PORT=3100

# ── DB ───────────────────────────────────────────
# 길고 무작위한 값으로 (예: openssl rand -hex 24)
POSTGRES_PASSWORD=

# ── 웹 푸시 (npx web-push generate-vapid-keys) ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# ── 문자 인증 ───────────────────────────────────
# console = 문자 업체 연결 전(인증번호 000000 고정, 누구나 가입 가능하니 테스트용으로만)
SMS_PROVIDER=console
SMS_FIXED_CODE=

# ── 카카오톡 공유 ───────────────────────────────
KAKAO_JS_KEY=

# ── 운영 관리자 첫 계정 (처음 한 번만 쓰임) ─────
OPERATOR_INIT_LOGIN_ID=
OPERATOR_INIT_PASSWORD=
OPERATOR_INIT_ROLLBACK_PIN=
OPERATOR_INIT_NAME=
OPERATOR_INIT_PHONE=
ADMIN_ALLOWED_IPS=

# ── 기타 ─────────────────────────────────────────
NEXT_PUBLIC_NOTIFY_QUIET_HOURS=
DEPLOY_PROVIDER=console
CRON_SECRET=
