// PT 관리앱 Prisma 스키마
// - 모든 시각은 UTC로 저장하고 화면에서 Asia/Seoul로 변환한다.
// - 롤백 기능 때문에 마이그레이션은 한 버전 이전 코드와 호환되게 작성한다
//   (컬럼 삭제는 두 번에 나눠 배포).
// - 엔티티는 docs/02_데이터모델.md를 기준으로 마일스톤마다 추가한다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuditActorType {
  USER
  OPERATOR
  SYSTEM
}

/// 예약·승인·차감·이용권·권한 변경 기록 (docs/02 공통)
model AuditLog {
  id        String         @id @default(cuid())
  actorType AuditActorType
  actorId   String?
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  at        DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([entity, entityId])
  @@index([actorType, actorId])
  @@index([at])
}

// ───────────────────────── M1: 계정·인증 ─────────────────────────

enum UserRole {
  TRAINER
  STUDENT
  CENTER_ADMIN
}

enum UserStatus {
  ACTIVE
  WITHDRAWING
  DELETED
}

enum DisplayMode {
  AUTO
  MOBILE
  PC
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id                  String      @id @default(cuid())
  loginId             String      @unique
  /// 형식: pbkdf2-sha256$<반복>$<base64 해시>
  passwordHash        String
  passwordSalt        String
  passwordChangedAt   DateTime    @default(now())
  /// 직전 비밀번호(재설정 시 같은 비밀번호 금지 검사용)
  prevPasswordHash    String?
  prevPasswordSalt    String?
  role                UserRole
  name                String
  /// 숫자만 저장 (01012345678)
  phone               String      @unique
  phoneVerifiedAt     DateTime
  gender              Gender?
  /// 한국 날짜 00:00 KST의 UTC 시점
  birthDate           DateTime?
  status              UserStatus  @default(ACTIVE)
  withdrawRequestedAt DateTime?
  deleteScheduledAt   DateTime?
  loginFailCount      Int         @default(0)
  lockedUntil         DateTime?
  displayMode         DisplayMode @default(AUTO)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  studentProfile         StudentProfile?
  trainerProfile         TrainerProfile?
  sessions               Session[]
  termsConsents          TermsConsent[]
  student                Student?                @relation("StudentUser")
  centerAdmins           CenterAdmin[]           @relation("CenterAdminUser")
  memberships            CenterMembership[]
  linkRequestsFrom       LinkRequest[]           @relation("LinkFrom")
  trainerLinks           TrainerStudentLink[]
  passesSold             Pass[]                  @relation("PassSoldBy")
  ruleSets               RuleSet[]
  trainerBookings        Booking[]               @relation("BookingTrainer")
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  linkRequestsTo         LinkRequest[]           @relation("LinkTo")

  @@index([role, name])
}

model StudentProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinHash              String
  pinSalt              String
  pinFailCount         Int       @default(0)
  pinLockedUntil       DateTime?
  /// 가입 때 고른 트레이너가 미가입이면 이름만 저장 (명세 1.1)
  requestedTrainerName String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model TrainerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 센터 미가입 시 직접 입력한 근무지
  workplaceText       String?
  workplaceAddress    String?
  /// "HH:mm", 08:00~21:00
  dayBeforeNotifyTime String   @default("20:00")
  hasCenterAdmin      Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Session {
  id          String    @id @default(cuid())
  /// 토큰의 SHA-256 (토큰은 32바이트 난수라 단일 해시로 충분)
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 자동 로그인 여부. true면 30일 슬라이딩, false면 브라우저 세션 + 12시간 슬라이딩
  persistent  Boolean   @default(false)
  deviceLabel String
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, revokedAt])
}

enum SmsPurpose {
  SIGNUP
  FIND_ID
  RESET_PW
  RESET_PIN
  CHANGE_PHONE
  WITHDRAW
  ADMIN_2FA
}

model SmsVerification {
  id         String     @id @default(cuid())
  phone      String
  purpose    SmsPurpose
  codeHash   String
  codeSalt   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  verifiedAt DateTime?
  /// 인증 결과를 가입·재설정 등에 한 번 쓰면 기록 (재사용 금지)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([phone, createdAt])
}

enum TermsKind {
  SERVICE
  PRIVACY
  THIRD_PARTY
  NOTIFY
  MARKETING
}

model TermsVersion {
  id          String         @id @default(cuid())
  kind        TermsKind
  version     String
  title       String
  required    Boolean
  body        String
  effectiveAt DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  consents    TermsConsent[]

  @@unique([kind, version])
}

model TermsConsent {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersionId String
  termsVersion   TermsVersion @relation(fields: [termsVersionId], references: [id])
  agreed         Boolean
  agreedAt       DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, termsVersionId])
}

// ───────── 가입 때 필요한 최소 연결 정보 (화면·처리는 M2, M7에서 확장) ─────────

/// 사람 단위 수강생. 미가입 수강생도 여기 (docs/02)
model Student {
  id               String               @id @default(cuid())
  userId           String?              @unique
  user             User?                @relation("StudentUser", fields: [userId], references: [id])
  name             String
  phone            String
  currentTrainerId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  linkRequests     LinkRequest[]
  trainerLinks     TrainerStudentLink[]
  passes           Pass[]
  ruleConsents     RuleConsent[]
  bookings         Booking[]

  @@index([phone])
  @@index([currentTrainerId])
}

enum LinkRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  /// 보낸 쪽 취소, 또는 가입 시 기존 기록과 합쳐져 필요 없어짐
  CANCELED
}

model LinkRequest {
  id          String            @id @default(cuid())
  fromUserId  String
  fromUser    User              @relation("LinkFrom", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User              @relation("LinkTo", fields: [toUserId], references: [id])
  studentId   String?
  student     Student?          @relation(fields: [studentId], references: [id])
  status      LinkRequestStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([toUserId, status])
}

enum CenterStatus {
  ACTIVE
  DISSOLVING
  DISSOLVED
}

model Center {
  id          String             @id @default(cuid())
  name        String
  address     String
  phone       String
  bizNo       String?
  /// 사업자등록번호 입력 시 "인증 센터"
  verified    Boolean            @default(false)
  status      CenterStatus       @default(ACTIVE)
  dissolveAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  admins      CenterAdmin[]
  memberships CenterMembership[]

  @@index([name])
}

model CenterAdmin {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  userId    String
  user      User     @relation("CenterAdminUser", fields: [userId], references: [id])
  invitedBy String?
  addedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, userId])
}

enum MembershipStatus {
  PENDING
  ACTIVE
  LEFT
}

model CenterMembership {
  id        String           @id @default(cuid())
  centerId  String
  center    Center           @relation(fields: [centerId], references: [id])
  trainerId String
  trainer   User             @relation(fields: [trainerId], references: [id])
  status    MembershipStatus @default(PENDING)
  consentAt DateTime?
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([trainerId, status])
  @@index([centerId, status])
}

// ───────────────────────── M2: 수강생·이용권·규칙 ─────────────────────────

enum TrainerStudentLinkStatus {
  ACTIVE
  ENDED
  /// 수강 종료: 목록에서 숨기고 기록은 보관
  HIDDEN
}

/// 담당 이력. 현재 담당은 endedAt null 하나
model TrainerStudentLink {
  id              String                   @id @default(cuid())
  trainerId       String
  trainer         User                     @relation(fields: [trainerId], references: [id])
  studentId       String
  student         Student                  @relation(fields: [studentId], references: [id])
  startedAt       DateTime                 @default(now())
  endedAt         DateTime?
  endReason       String?
  memo            String                   @default("")
  memoTransferred Boolean                  @default(false)
  notifyDayBefore Boolean                  @default(true)
  notify2h        Boolean                  @default(true)
  status          TrainerStudentLinkStatus @default(ACTIVE)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([trainerId, status])
  @@index([studentId, endedAt])
}

enum RuleSetKind {
  /// 트레이너 기본 규칙
  TRAINER_DEFAULT
  /// 센터 기본 규칙 (M7)
  CENTER_DEFAULT
  /// 수강생별로 고친 이용권 규칙
  PASS
}

/// 수강 규칙. 바뀌면 새 버전(새 행)을 만든다
model RuleSet {
  id                         String      @id @default(cuid())
  kind                       RuleSetKind
  ownerTrainerId             String?
  ownerTrainer               User?       @relation(fields: [ownerTrainerId], references: [id])
  ownerCenterId              String?
  /// 같은 소유자(트레이너 기본 / 센터 기본 / 이용권) 안에서 1부터 증가
  version                    Int
  lateCancelHours            Int         @default(24)
  lateCancelDeduct           Boolean     @default(true)
  noShowMinutes              Int         @default(15)
  noShowDeduct               Boolean     @default(true)
  lateGraceMinutes           Int         @default(15)
  unapprovedAutoCompleteDays Int         @default(7)
  changeDeadlineHours        Int         @default(24)
  pauseMaxDays               Int         @default(30)
  pauseMaxCount              Int         @default(2)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  passesProposed Pass[]        @relation("PassRuleSet")
  passesAgreed   Pass[]        @relation("PassAgreedRuleSet")
  consents       RuleConsent[]

  @@index([ownerTrainerId, kind, version])
}

enum PassStatus {
  ACTIVE
  PAUSED
  EXHAUSTED
  EXPIRED
  REFUNDED
  /// 트레이너 변경 시 넘기기에 동의하지 않아 사용 중지
  SUSPENDED
}

model Pass {
  id                 String     @id @default(cuid())
  studentId          String
  student            Student    @relation(fields: [studentId], references: [id])
  soldByTrainerId    String
  soldByTrainer      User       @relation("PassSoldBy", fields: [soldByTrainerId], references: [id])
  name               String
  count              Int
  bonusCount         Int        @default(0)
  /// 한국 날짜 00:00 KST의 UTC 시점
  startDate          DateTime
  /// 한국 날짜 00:00 KST의 UTC 시점 (이 날까지 사용 가능)
  endDate            DateTime
  sessionMinutes     Int        @default(50)
  price              Int?
  paidAt             DateTime?
  payMethod          String?
  memo               String?
  /// 최근에 제안한 규칙 (동의 요청 중일 수 있음)
  ruleSetVersionId   String
  ruleSet            RuleSet    @relation("PassRuleSet", fields: [ruleSetVersionId], references: [id])
  /// 수강생이 동의한 규칙. 새 규칙에 동의하기 전까지는 이 규칙을 적용한다
  agreedRuleSetId    String?
  agreedRuleSet      RuleSet?   @relation("PassAgreedRuleSet", fields: [agreedRuleSetId], references: [id])
  agreedAt           DateTime?
  status             PassStatus @default(ACTIVE)
  refundedAt         DateTime?
  /// 캐시. 정답은 Booking에서 계산 (getAvailableCount)
  usedCount          Int        @default(0)
  deductedNoShow     Int        @default(0)
  deductedLateCancel Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  changeLogs PassChangeLog[]
  consents   RuleConsent[]
  bookings   Booking[]

  @@index([studentId, status])
}

model PassChangeLog {
  id        String   @id @default(cuid())
  passId    String
  pass      Pass     @relation(fields: [passId], references: [id])
  field     String
  before    String?
  after     String?
  changedBy String
  changedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passId, changedAt])
}

enum RuleConsentStatus {
  PENDING
  AGREED
  INQUIRED
  /// 더 새 규칙으로 다시 요청해 쓸모없어짐
  SUPERSEDED
}

model RuleConsent {
  id               String            @id @default(cuid())
  passId           String
  pass             Pass              @relation(fields: [passId], references: [id])
  ruleSetVersionId String
  ruleSet          RuleSet           @relation(fields: [ruleSetVersionId], references: [id])
  studentId        String
  student          Student           @relation(fields: [studentId], references: [id])
  status           RuleConsentStatus @default(PENDING)
  requestedAt      DateTime          @default(now())
  agreedAt         DateTime?
  inquiredAt       DateTime?
  inquiryText      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([studentId, status])
  @@index([passId, status])
}

// ───────── 예약 (잔여·예약 가능 횟수 계산에 필요. 화면·상태 머신은 M3) ─────────

enum BookingStatus {
  /// 신청 대기
  REQUESTED
  /// 확정 대기
  PENDING_CONFIRM
  CONFIRMED
  /// 잔여 부족
  INSUFFICIENT
  /// 완료 승인 대기
  PENDING_APPROVAL
  COMPLETED
  NO_SHOW
  CANCELED
  REJECTED
  EXPIRED
}

enum BookingSource {
  TRAINER
  STUDENT
}

enum DeductReason {
  COMPLETED
  NO_SHOW
  LATE_CANCEL
}

model Booking {
  id                  String         @id @default(cuid())
  studentId           String
  student             Student        @relation(fields: [studentId], references: [id])
  /// 진행 트레이너 (기록용으로 고정)
  trainerId           String
  trainer             User           @relation("BookingTrainer", fields: [trainerId], references: [id])
  /// 차감된 이용권 (차감될 때 정해짐)
  passId              String?
  pass                Pass?          @relation(fields: [passId], references: [id])
  startAt             DateTime
  endAt               DateTime
  source              BookingSource
  status              BookingStatus
  /// 잔여 부족으로 바뀌기 전 상태 (복구용)
  prevStatus          BookingStatus?
  insufficientAt      DateTime?
  autoConfirmed       Boolean        @default(false)
  recurringGroupId    String?
  memo                String?
  /// 수강생 취소 요청 (명세 4.7). 차감 판단은 요청 시각 기준
  cancelRequestedAt   DateTime?
  cancelRequestedBy   String?
  cancelRequestReason String?
  canceledAt          DateTime?
  /// 사용자 id 또는 "SYSTEM"
  canceledBy          String?
  cancelReason        String?
  rejectReason        String?
  deducted            Boolean        @default(false)
  deductReason        DeductReason?
  deductSkippedReason String?
  notifyDayBeforeOff  Boolean        @default(false)
  notify2hOff         Boolean        @default(false)
  /// 하위 호환: 이전 버전 코드가 넣는 행도 들어가도록 기본값을 둔다
  createdBy           String         @default("SYSTEM")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  changeRequests BookingChangeRequest[]
  statusLogs     BookingStatusLog[]

  @@index([studentId, status])
  @@index([trainerId, startAt])
  @@index([status, startAt])
  @@index([recurringGroupId])
}

enum ChangeRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  /// 상대방이 다른 시간을 제안해 새 요청으로 바뀜
  COUNTERED
  /// 예약이 취소되는 등으로 필요 없어짐
  CANCELED
}

enum ChangeRequestKind {
  /// 확정된 예약의 시간 변경 요청 (4.6)
  CHANGE
  /// 확정 대기 예약에 수강생이 다른 시간 제안 (4.4)
  PROPOSAL
}

model BookingChangeRequest {
  id            String              @id @default(cuid())
  bookingId     String
  booking       Booking             @relation(fields: [bookingId], references: [id])
  kind          ChangeRequestKind
  requestedBy   String
  /// [{ startAt, endAt }] 1~3개 (ISO)
  proposedSlots Json
  status        ChangeRequestStatus @default(PENDING)
  expiresAt     DateTime
  chosenSlot    Json?
  respondedAt   DateTime?
  respondedBy   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([bookingId, status])
  @@index([status, expiresAt])
}

model BookingStatusLog {
  id        String         @id @default(cuid())
  bookingId String
  booking   Booking        @relation(fields: [bookingId], references: [id])
  from      BookingStatus?
  to        BookingStatus
  /// 사용자 id 또는 "SYSTEM"
  by        String
  reason    String?
  at        DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([bookingId, at])
}

/// 근무 가능 시간 (요일별 시간대, 4.3)
model AvailabilityRule {
  id        String   @id @default(cuid())
  trainerId String
  trainer   User     @relation(fields: [trainerId], references: [id])
  /// 0(일)~6(토)
  weekday   Int
  /// "HH:mm"
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainerId, weekday])
}

/// 휴무일·예외일
model AvailabilityException {
  id        String   @id @default(cuid())
  trainerId String
  trainer   User     @relation(fields: [trainerId], references: [id])
  /// 한국 날짜 00:00 KST의 UTC 시점
  date      DateTime
  startTime String?
  endTime   String?
  isOff     Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainerId, date])
}
