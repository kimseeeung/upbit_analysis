# PT 관리앱 환경 변수 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채웁니다. 실제 값은 절대 커밋하지 않습니다.

# ── 앱 ───────────────────────────────────────────
# 서비스 주소 (카톡 공유 링크, 웹 푸시 클릭 주소에 사용)
APP_BASE_URL=http://localhost:3000

# ── 데이터베이스 (PostgreSQL) ────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ptapp?schema=public

# ── 웹 푸시 (VAPID) ──────────────────────────────
# 발급: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 연락처 (mailto: 또는 https:)
VAPID_SUBJECT=

# ── SMS 본인인증 (발송 대행사) ───────────────────
# console = 개발용(인증번호를 서버 콘솔에 출력), 그 외 = 대행사 어댑터 이름
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NUMBER=

# ── 카카오톡 공유 (Kakao JavaScript SDK) ─────────
KAKAO_JS_KEY=

# ── 운영 관리자 초기 계정 (배포 시 첫 관리자 생성용) ─
# 아이디·비밀번호·롤백 PIN은 코드·문서·시드에 쓰지 않고 여기서만 읽습니다.
OPERATOR_INIT_LOGIN_ID=
OPERATOR_INIT_PASSWORD=
# 숫자 6자리
OPERATOR_INIT_ROLLBACK_PIN=
OPERATOR_INIT_NAME=
OPERATOR_INIT_PHONE=

# ── 테스트 ───────────────────────────────────────
# DB 통합 테스트(npm run test:db)가 비우고 쓰는 별도 DB. 운영·개발 DB를 넣지 마세요.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@localhost:5432/ptapp_test?schema=public
# E2E에서만: 콘솔 SMS를 /api/dev/sms-outbox로 읽기 (운영에서는 켜지 마세요)
SMS_DEV_OUTBOX=
# E2E(npm run test:e2e)가 쓰는 별도 DB
DATABASE_URL_E2E=postgresql://USER:PASSWORD@localhost:5432/ptapp_e2e?schema=public

# ── 자동 처리 ───────────────────────────────────
# 1 = 서버가 뜰 때 pg-boss를 시작해 1분마다 자동 처리(확정·만료·승인·알림 발송)
JOBS_ENABLED=1
# pg-boss 없이 점검할 때: POST /api/cron/tick (Authorization: Bearer <값>). 비우면 닫힘
CRON_SECRET=
